{
  "name": "war-land-backend",
  "version": "0.0.1",
  "description": "WarLand NestJS backend (engine, matchmaking, persistence, WebSockets).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "lint": "oxlint src/ test/ scripts/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "loadtest": "node scripts/loadtest.mjs",
    "seed:cards": "prisma db execute --file scripts/seed-cards.sql --schema prisma/schema.prisma",
    "contract:emit": "prisma contract emit",
    "game:terminal": "nest build && node dist/dev/terminal-demo.js",
    "game:terminal:online": "nest build && node dist/dev/terminal-client.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/websockets": "^12.0.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}

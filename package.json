{
  "name": "war-land",
  "version": "0.0.1",
  "description": "WarLand — TCG PvP game. npm workspaces root (backend + frontend).",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w backend",
    "dev": "npm run dev -w frontend",
    "start": "npm run start -w backend",
    "start:dev": "npm run start:dev -w backend",
    "start:prod": "npm run start:prod -w backend",
    "lint": "npm run lint -w backend",
    "format": "npm run format -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "npm run test:e2e -w backend",
    "loadtest": "npm run loadtest -w backend",
    "seed:cards": "npm run seed:cards -w backend",
    "contract:emit": "npm run contract:emit -w backend",
    "game:terminal": "npm run game:terminal -w backend",
    "game:terminal:online": "npm run game:terminal:online -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "frontend:build": "npm run build -w frontend",
    "frontend:preview": "npm run preview -w frontend",
    "frontend:typecheck": "npm run typecheck -w frontend",
    "frontend:test": "npm run test -w frontend",
    "frontend:test:watch": "npm run test:watch -w frontend"
  }
}
